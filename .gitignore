# ========================================
# PROJECT TEMPLATE .gitignore
# Copy this to any derived project and
# uncomment sections relevant to your stack.
# ========================================

# ========================================
# OS / File System
# ========================================
.DS_Store
.DS_Store?
.AppleDouble
.LSOverride
Icon?
._*
.Spotlight-V100
.Trashes
Thumbs.db
Desktop.ini
ehthumbs.db
$RECYCLE.BIN/
*.lnk

# ========================================
# Environment / Secrets
# ========================================
.env
.env.*
!.env.example
!.env.template
*.local
*.secret
**/secrets/**
**/credentials/**
*.key
*.pem
*.keystore
*.p12
*.cert
**/.auth/**
**/tokens/**
service-account*.json

# ========================================
# Dependencies
# ========================================

# Node / JavaScript / TypeScript
**/node_modules/
.jitpack
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*
.eslintcache
.stylelintcache
*.tsbuildinfo
tsconfig.tsbuildinfo

